flowchart TB
    UA["User A<br/><i>owns their SMTPs</i>"]
    UB["User B<br/><i>owns their SMTPs</i>"]

    subgraph platform["Platform &mdash; not built yet"]
        P["Campaigns · CSV · templates<br/>Monthly subscription<br/>Enables / disables the module per user"]
    end

    subgraph brain["Brain &mdash; Go control plane"]
        API["API layer<br/>quote · run · report · describe<br/><b>+ account CRUD extension</b>"]
        GATE["<b>From gate</b><br/>SPF / DMARC check<br/>at setup only"]
        DISP["Dispatcher<br/>claim · route · pace<br/><i>flat per-user account list</i>"]
        OUT["Outcome handler<br/>classify · score · quarantine"]
    end

    subgraph boxes["Sender boxes &mdash; Node, N containers"]
        B1["Box 1"]
        B2["Box N"]
    end

    DB[("Shared Supabase<br/><i>sender schema</i>")]

    EXT1["User A's provider<br/>Gmail · SES · custom"]
    EXT2["User B's provider"]

    UA -.->|"adds SMTP credentials"| P
    UB -.->|"adds SMTP credentials"| P
    P ==>|"platform service token"| API
    API --> GATE
    API --> DB
    DISP <--> DB
    OUT --> DB
    DISP ==>|"push job<br/>+ decrypted credential"| B1
    DISP ==>|"push job<br/>+ decrypted credential"| B2
    B1 -->|"outcome"| OUT
    B2 -->|"outcome"| OUT
    B1 ==>|"authenticated SMTP"| EXT1
    B2 ==>|"authenticated SMTP"| EXT2

    classDef userNode fill:#e8f0fe,stroke:#4285f4,stroke-width:2px
    classDef brainNode fill:#f3e8fd,stroke:#9334e6,stroke-width:2px
    classDef boxNode fill:#fde8e8,stroke:#d93025,stroke-width:2px
    classDef extNode fill:#f1f3f4,stroke:#5f6368,stroke-width:1px

    class UA,UB userNode
    class API,GATE,DISP,OUT brainNode
    class B1,B2 boxNode
    class EXT1,EXT2,DB,P extNode
