# ── Secrets & key material — NEVER committed ────────────────────────────────
# Private keys use the .key extension (ca.key, brain.key, box-<id>.key, sink.key)
# and the harness generates ephemeral certs OUTSIDE secrets/, so cover every location.
*.key
*.pem
secrets/
!secrets/.gitkeep
**/certs/*.key
**/certs/*.crt
tests/harness/certs/
deploy/certs/
.env
.env.*
!.env.example
!.env.ci

# ── Go (Brain) ──────────────────────────────────────────────────────────────
/services/brain/bin/
/tools/sender-migrate/bin/
*.exe
*.out
*.test

# ── Node (box) ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.tsbuildinfo
/services/box/dist/

# ── misc ────────────────────────────────────────────────────────────────────
.DS_Store
*.log
/tmp/
coverage/

# Reference codebase (has its own nested .git; inspiration only, not part of this repo)
Docs/mailflow-worker (Sender Inspiration)/
