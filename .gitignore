# ── Secrets & key material — NEVER committed ────────────────────────────────
# Private keys use the .key extension (ca.key, brain.key, box-<id>.key, sink.key)
# and the harness generates ephemeral certs OUTSIDE secrets/, so cover every location.
*.key
*.pem
secrets/*
!secrets/.gitkeep
**/certs/*.key
**/certs/*.crt
tests/harness/certs/
deploy/certs/
.env
.env.*
!.env.example
!.env.ci

# ── Go (Brain) ──────────────────────────────────────────────────────────────
/services/brain/bin/
/tools/sender-migrate/bin/
/tools/provision-box/bin/
**/bin/sender-migrate
**/bin/provision-box
*.exe
*.out
*.test

# ── Node (box) ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.tsbuildinfo
/services/box/dist/

# ── misc ────────────────────────────────────────────────────────────────────
.DS_Store
*.log
/tmp/
coverage/

# Scratch output from tests/manual/launch-campaign.sh — the job_item/job id lists it writes so a
# follow-up assertion can name the exact rows it expects. Per-run and disposable; the SCRIPT is
# tracked, its output is not.
*.ids
*.items

# Reference codebase (has its own nested .git; inspiration only, not part of this repo)
Docs/history/mailflow-worker (Sender Inspiration)/
