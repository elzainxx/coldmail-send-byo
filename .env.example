# .env.example — documented env vars for local dev. Copy to .env (gitignored) and fill in.
# NO SECRET IS COMMITTED. Real values come from env / secret store. Generate the dev
# material with: scripts/dev.sh certs   (runs gen-certs + gen-secrets + provision-box).

# ── Postgres (dev) ───────────────────────────────────────────────────────────
POSTGRES_SUPERPASS=devsuperpass          # dev-only superuser password for the pg container
# Admin/owner-capable DSN the migration runner uses (OD-1) — distinct from sender_module.
MIGRATE_DATABASE_URL=postgres://postgres:devsuperpass@postgres:5432/platform
# The Brain connects as the LOGIN app role sender_module (password set out-of-band).
SENDER_MODULE_PASSWORD=devmodulepass
DATABASE_URL=postgres://sender_module:devmodulepass@postgres:5432/platform

# ── Brain: KMS (SOLE decryptor) ──────────────────────────────────────────────
KMS_DEV_KEY_FILE=/secrets/kms/dev-master.key      # Brain-only mount; box never gets this

# ── Brain: singleton + addresses (Phase-0 bootstrap wiring, OD-18) ───────────
BRAIN_SINGLETON_ACQUIRE_TIMEOUT_SEC=60
BRAIN_HEALTH_ADDR=:8080
BRAIN_BOXLINK_ADDR=:8443

# ── mTLS material (paths, not secrets) ───────────────────────────────────────
MTLS_SERVER_CERT=/secrets/mtls/brain.crt
MTLS_SERVER_KEY=/secrets/mtls/brain.key
MTLS_CA_CERT=/secrets/mtls/ca.crt
# Box side:
MTLS_CLIENT_CERT=/secrets/mtls/box.crt
MTLS_CLIENT_KEY=/secrets/mtls/box.key

# ── Auth domains (never share a credential) ──────────────────────────────────
# Domain A — platform service token (quote/run/report/describe). Not exercised in Phase 0.
PLATFORM_SERVICE_TOKEN=dev-platform-service-token
# Domain B — operator admin key: the Brain holds only the HASH (from gen-secrets).
PLATFORM_ADMIN_KEY_HASH=replace-with-sha256-from-gen-secrets

# ── Box registration (P9-A: token=authority) ─────────────────────────────────
DEV_BOX_ID=dev-box-1
DEV_BOX_TOKEN=replace-with-token-from-provision-box       # box presents this
DEV_BOX_TOKEN_HASH=replace-with-bcrypt-hash-from-provision-box   # Brain verifies against this
BOX_HEARTBEAT_INTERVAL_SEC=10

# ── Alerting (Phase 9.5; "" = off) ───────────────────────────────────────────
SENDER_ALERT_WEBHOOK_URL=
