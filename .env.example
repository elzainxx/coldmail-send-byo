# .env.example — documented env vars for local dev. Copy to .env (gitignored) and fill in.
# NO SECRET IS COMMITTED. Real values come from env / secret store. Generate the dev
# material with: scripts/dev.sh certs   (runs gen-certs + gen-secrets + provision-worker).

# ── Host port bindings (M3-P0-OD-6) ──────────────────────────────────────────
# Compose project names namespace containers/networks but NOT host port bindings. Module 2
# binds the identical container-internal ports on host 5432/8080/8443/8444/8025, so running
# both stacks at once needs distinct host-side ports or the second bind fails — or worse, a
# harness run silently reaches the OTHER module's Control through a shared host port. Defaults
# below are module 2's ports +1000; override here if they still collide on your host.
HOST_PORT_POSTGRES=6432
HOST_PORT_CONTROL_HEALTH=9080
HOST_PORT_CONTROL_WORKERLINK=9443
HOST_PORT_CONTROL_STREAM=9444
HOST_PORT_MAILPIT=9025
# Phase 4 "From gate" test DNS (Docs/history/phase-4-from-gate.md §7.1) — coredns container port 53,
# both protocols bound to the same host port by default since a DNS client picks UDP or TCP
# itself. `go test` runs (outside Docker) dial localhost:<this port>; the Control, once it also
# runs as a compose service, reaches the same server container-to-container at coredns:53.
HOST_PORT_COREDNS_UDP=9053
HOST_PORT_COREDNS_TCP=9053

# ── Postgres (dev) ───────────────────────────────────────────────────────────
POSTGRES_SUPERPASS=devsuperpass          # dev-only superuser password for the pg container
# Admin/owner-capable DSN the migration runner uses (OD-1) — distinct from send_byo_app.
MIGRATE_DATABASE_URL=postgres://postgres:devsuperpass@postgres:5432/platform
# The Control connects as the LOGIN app role send_byo_app (password set out-of-band).
SEND_BYO_MODULE_PASSWORD=devmodulepass
DATABASE_URL=postgres://send_byo_app:devmodulepass@postgres:5432/platform

# ── Control: KMS (SOLE decryptor) ──────────────────────────────────────────────
KMS_DEV_KEY_FILE=/secrets/kms/dev-master.key      # Control-only mount; worker never gets this

# ── Control: singleton + addresses (Phase-0 bootstrap wiring, OD-18) ───────────
CONTROL_SINGLETON_ACQUIRE_TIMEOUT_SEC=60
CONTROL_HEALTH_ADDR=:8080
CONTROL_WORKERLINK_ADDR=:8443

# ── mTLS material (paths, not secrets) ───────────────────────────────────────
MTLS_SERVER_CERT=/secrets/mtls/control.crt
MTLS_SERVER_KEY=/secrets/mtls/control.key
MTLS_CA_CERT=/secrets/mtls/ca.crt
# Worker side:
MTLS_CLIENT_CERT=/secrets/mtls/worker.crt
MTLS_CLIENT_KEY=/secrets/mtls/worker.key

# ── Auth domains (never share a credential) ──────────────────────────────────
# INERT — both variables below are Phase-0 scaffolds that NO CODE READS. They are kept only so an
# older .env does not look truncated. The live variables are PLATFORM_TOKEN_HASHES (Domain A) and
# ADMIN_API_KEY_HASHES (Domain B), both comma-separated BCRYPT lists minted by tools/provision-worker
# admin-key — not a plaintext token and not a SHA-256. Setting either line below has no effect;
# a Domain A call with PLATFORM_SERVICE_TOKEN set and PLATFORM_TOKEN_HASHES empty returns 401
# (fail-closed). See Docs/install-and-deploy.md Step 6.
PLATFORM_SERVICE_TOKEN=dev-platform-service-token
PLATFORM_ADMIN_KEY_HASH=replace-with-sha256-from-gen-secrets

# ── Worker registration (P9-A: token=authority) ─────────────────────────────────
DEV_WORKER_ID=dev-worker-1
DEV_WORKER_TOKEN=replace-with-token-from-provision-worker       # worker presents this
DEV_WORKER_TOKEN_HASH=replace-with-bcrypt-hash-from-provision-worker   # Control verifies against this
WORKER_HEARTBEAT_INTERVAL_SEC=10

# ── Alerting (Phase 9.5; "" = off) ───────────────────────────────────────────
SEND_BYO_ALERT_WEBHOOK_URL=
